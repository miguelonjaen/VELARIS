      "type": "string",
      "enum": [
        "ROUTE",
        "OTHER"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATE",
        "MODIFY",
        "QUERY",
        "CLARIFY",
        "NONE"
      ]
    },
    "origin": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "destination": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "via": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "PORT",
              "ISLAND",
              "CAPE",
              "PLACE"
