          },
          "mode": {
            "type": "string",
            "enum": [
              "PASS",
              "CALL",
              "UNSPECIFIED"
            ]
          },
          "distanceNm": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name",
          "kind",
          "mode",
          "distanceNm"
        ]
      }
